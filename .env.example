# === 服务端口 ===
# 由于宿主机 80/443 可能已被占用，使用高阶端口
HTTP_PORT=18083
HTTPS_PORT=18084
BACKEND_PORT=18003

# === 安全密钥（首次部署必须生成并替换！）===
# JWT 签名密钥，>=32字符
# 生成命令: openssl rand -hex 32
UNIPUS_SECRET=CHANGE_ME_32CHARS_MINIMUM

# AES 密钥前缀，>=8字符
AES_KEY_PREFIX=CHANGE_ME_8CHARS

# 任务密码加密密钥（Fernet，44字符 base64）
# 生成命令: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TASK_ENCRYPTION_KEY=CHANGE_ME_44CHAR_BASE64

# === CORS 配置 ===
# 允许的跨域来源（逗号分隔），生产环境必须限制为实际域名
ALLOWED_ORIGINS=https://localhost,https://127.0.0.1

# === SMTP 配置（可选，用于邮件通知）===
# 使用 QQ 邮箱时，SMTP_PASSWORD 需填写授权码而非登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_FROM=your@qq.com
ADMIN_EMAIL=admin@example.com
